# ISP Search — local environment template.
# Copy to `.env` with `pnpm env:init` (generates the HMAC secret) or `cp .env.example .env`.
# Never commit `.env`. Never put a production value in this file.

# --- shared server values (web + worker) ---
# NODE_ENV is set by the process runner (next build/start, node). Do not set it here:
# a development value would make `next build` emit a development React bundle.
LOG_LEVEL=info
# Local Docker Compose database (see docker-compose.yml). Development credential only.
# secretlint-disable-next-line
DATABASE_URL=postgresql://isp_search:isp_search_dev@localhost:55432/isp_search
# Integration tests use a separate database when set; falls back to DATABASE_URL in CI.
# secretlint-disable-next-line
DATABASE_URL_TEST=postgresql://isp_search:isp_search_dev@localhost:55432/isp_search
# Key material for the versioned HMAC address identity (>= 32 chars). Generate: openssl rand -hex 32
ADDRESS_HMAC_SECRET=
# Bump when rotating ADDRESS_HMAC_SECRET; old cache identities expire naturally.
ADDRESS_HMAC_KEY_VERSION=1
# AES-256-GCM key (64 hex chars) for short-lived encrypted raw-address rows. Generate: openssl rand -hex 32
RAW_ADDRESS_ENCRYPTION_KEY=
# Bump when rotating RAW_ADDRESS_ENCRYPTION_KEY; old rows become undecryptable and are swept.
RAW_ADDRESS_KEY_VERSION=1
# Retention (minutes; ADR-007 ceilings are 1440 = 24h). Raw address is also deleted early
# whenever every provider job for the search has settled.
RAW_ADDRESS_TTL_MINUTES=30
SEARCH_TTL_MINUTES=60
# Global per-search orchestration deadline in seconds.
SEARCH_DEADLINE_SECONDS=40
# Consent copy version recorded on each search.
CONSENT_VERSION=dev-2026-09
# AddressResolver selection (ADR-002). `synthetic` is the deterministic development default.
# `smarty` remains disabled until a consented corpus (PLA-349) and credentials/terms exist.
ADDRESS_RESOLVER=synthetic
SMARTY_ENABLED=false
# SMARTY_AUTH_ID=
# SMARTY_AUTH_TOKEN=
# Debug payload capture is opt-in and TTL-bounded (max 24h). Keep off unless investigating.
DEBUG_CAPTURE_ENABLED=false
DEBUG_CAPTURE_TTL_HOURS=1

# --- web ---
PORT=3000
APP_BASE_URL=http://localhost:3000
# Browser-visible values only. Anything prefixed NEXT_PUBLIC_ is inlined into client bundles.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=ISP Search

# --- worker ---
WORKER_HEALTH_PORT=3100
WORKER_CONCURRENCY=4
JOB_QUEUE_SCHEMA=pgboss
SHUTDOWN_GRACE_MS=15000

# --- tests ---
# Deterministic suites block outbound network. Only set to true for explicit live canaries.
ISP_SEARCH_TEST_NETWORK=false
