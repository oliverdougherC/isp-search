{
  "name": "@isp-search/web",
  "version": "0.0.0",
  "private": true,
  "description": "ISP Search public web application and search API surface (Next.js App Router).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
