    "@isp-search/providers": "workspace:*",
    "@isp-search/resolver": "workspace:*"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "pg": "catalog:",
    "@types/pg": "catalog:"
  }
