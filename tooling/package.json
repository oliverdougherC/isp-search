{
  "name": "@isp-search/tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Repository checks: network-disabled test setup, fixture PII/secret scanner, client-bundle canary scanner, and import-boundary tests.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "scan:fixtures": "node dist/fixture-scan/cli.js",
    "scan:bundle": "node dist/bundle-scan/cli.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@isp-search/domain": "workspace:*",
    "@isp-search/observability": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
